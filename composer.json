{
  "name": "boardtalk/editorial-scout",
  "description": "Source-led editorial discovery for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-only",
  "require": { "php": ">=8.0" },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "config": { "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true }, "platform": { "php": "8.0.30" } },
  "scripts": { "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l", "standards": "phpcs" }
}
